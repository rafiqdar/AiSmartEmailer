<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp">

    <!-- Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A73E8"
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_marginBottom="16dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="AI Smart Emailer v4.0 — Configuration"
          android:textColor="#FFFFFF"
          android:textSize="20sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="Share any PDF or Image from your phone → Fast Parallel AI/OCR extracts the full Subject → Opens Gmail prefilled &amp; ready to tap Send."
          android:textColor="#E8F0FE"
          android:textSize="13sp" />
    </LinearLayout>

    <!-- Section 1: Account Configuration -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. GMAIL ACCOUNTS"
        android:textColor="#1A73E8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="From Gmail Account (Configured Sender):"
        android:textColor="#202124"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editFromEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="your.account@gmail.com"
        android:inputType="textEmailAddress"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To Gmail Account(s) (Configured Recipient - comma separated for multiple):"
        android:textColor="#202124"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editToEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="recipient@gmail.com"
        android:inputType="textEmailAddress"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CC Account(s) (Optional):"
        android:textColor="#202124"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editCcEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="cc@gmail.com (optional)"
        android:inputType="textEmailAddress"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp" />

    <!-- Section 2: Prefilled Email Body & Complementary Close -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. PREFILLED BODY &amp; COMPLEMENTARY CLOSE"
        android:textColor="#1A73E8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Default Email Body (supports {Subject}, {FileName}, {Date}):"
        android:textColor="#202124"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editEmailBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Complementary Close &amp; Signature Lines:"
        android:textColor="#202124"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editComplementaryClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp" />

    <!-- Section 3: AI Agent & Advanced OCR Settings -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. AI AGENT &amp; ADVANCED OCR ENGINE"
        android:textColor="#1A73E8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI Vision / OCR Provider:"
        android:textColor="#202124"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spinnerAiProvider"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI API Key (Optional — Built-in Cloud OCR works automatically without a key):"
        android:textColor="#202124"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Optional: Gemini Key (AIza...) or OpenAI Key (sk-...)"
        android:inputType="textPassword"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI Model Name (default: gemini-2.5-flash):"
        android:textColor="#202124"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editAiModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="gemini-2.5-flash"
        android:inputType="text"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Max OCR Network Timeout in Seconds (5 to 30, default: 12):"
        android:textColor="#202124"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editOcrTimeout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="12"
        android:inputType="number"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI OCR Subject Extraction Instructions:"
        android:textColor="#202124"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editCustomPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="12dp" />

    <Switch
        android:id="@+id/switchImageEnhancement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enhance document contrast &amp; auto-rotate camera photos before OCR"
        android:textColor="#202124"
        android:textSize="14sp"
        android:layout_marginBottom="10dp" />

    <Switch
        android:id="@+id/switchSubjectCache"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cache extracted Subjects locally for instant (&lt; 5ms) repeat shares"
        android:textColor="#202124"
        android:textSize="14sp"
        android:layout_marginBottom="10dp" />

    <Switch
        android:id="@+id/switchAutoOpenGmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Automatically open Gmail app right after OCR subject extraction"
        android:textColor="#202124"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <!-- Optional Direct SMTP App Password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Optional Gmail App Password (only if using Direct SMTP Send button):"
        android:textColor="#5F6368"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/editSmtpAppPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Optional 16-char Gmail App Password"
        android:inputType="textPassword"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="#1A73E8"
        android:text="SAVE CONFIGURATION"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnClearCache"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:backgroundTint="#5F6368"
        android:text="CLEAR CACHED SUBJECTS"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

  </LinearLayout>
</ScrollView>
