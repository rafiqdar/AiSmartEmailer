<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A73E8"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="AI Smart Emailer v4.0 — Ready to Send"
          android:textColor="#FFFFFF"
          android:textSize="19sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/txtFileBadge"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="Attached: Document.pdf"
          android:textColor="#E8F0FE"
          android:textSize="13sp" />

      <TextView
          android:id="@+id/txtEngineBadge"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:text="OCR Engine: Initializing..."
          android:textColor="#D2E3FC"
          android:textSize="12sp" />
    </LinearLayout>

    <!-- Loading Indicator with Live Progress & Instant Skip Button -->
    <LinearLayout
        android:id="@+id/loadingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFF8E1"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

      <ProgressBar
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:indeterminate="true" />

      <TextView
          android:id="@+id/txtStatusMessage"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="10dp"
          android:layout_marginEnd="8dp"
          android:text="AI Agent &amp; OCR analyzing shared file..."
          android:textColor="#202124"
          android:textSize="13sp" />

      <Button
          android:id="@+id/btnSkipWait"
          android:layout_width="wrap_content"
          android:layout_height="38dp"
          android:backgroundTint="#E65100"
          android:text="SKIP WAIT"
          android:textColor="#FFFFFF"
          android:textStyle="bold"
          android:textSize="11sp" />
    </LinearLayout>

    <!-- Prefilled Fields Preview -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="From Account:"
        android:textColor="#5F6368"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/editShareFrom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textEmailAddress"
        android:padding="10dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To Account(s):"
        android:textColor="#5F6368"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/editShareTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textEmailAddress"
        android:padding="10dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Extracted Full Subject Line (via AI/OCR):"
          android:textColor="#1A73E8"
          android:textStyle="bold"
          android:textSize="14sp" />

      <Button
          android:id="@+id/btnRetryOcr"
          android:layout_width="wrap_content"
          android:layout_height="36dp"
          android:backgroundTint="#0D47A1"
          android:text="RE-SCAN AI / OCR"
          android:textColor="#FFFFFF"
          android:textStyle="bold"
          android:textSize="11sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/editShareSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prefilled Email Body &amp; Complementary Close:"
        android:textColor="#5F6368"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/editShareBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="5"
        android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnOpenGmail"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="#1A73E8"
        android:text="OPEN IN GMAIL APP (PREFILLED &amp; ATTACHED)"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnDirectSend"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#1E8E3E"
        android:text="DIRECT SEND NOW (VIA GMAIL SMTP)"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnOpenSettings"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:backgroundTint="#5F6368"
        android:text="EDIT CONFIGURATION SETTINGS"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

  </LinearLayout>
</ScrollView>
